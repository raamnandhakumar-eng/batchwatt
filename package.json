    "demo": "node scripts/export-plan.js samples/sample_plan_payload.json output/demo",
    "demo:energy": "node scripts/export-energy-plan.js samples/energy-demo.json output/energy-demo",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest"
  },
  "devDependencies": {
    "vercel": "latest"
  }
}
