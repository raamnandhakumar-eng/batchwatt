{
  "name": "batchwatt",
  "version": "2.0.0",
  "private": true,
  "description": "Energy-aware factory planning: shared inventory, line capacity, peak demand and tariff scenario comparison.",
  "scripts": {
    "dev": "vercel dev",
    "test:plan": "node samples/test_plan.js",
